# ---------------------------------------------------------------------
# Copy to .env. These are compiled into the JavaScript bundle at build
# time, so they are PUBLIC. Never put an API key here.
# ---------------------------------------------------------------------

# Where the FastAPI backend is running.
VITE_API_BASE_URL=http://localhost:8000

# Request timeout in ms. Model calls can be slow.
VITE_API_TIMEOUT=60000

# browser (default) | hash (hosts without SPA fallback) | memory (embedded)
# VITE_ROUTER=browser
