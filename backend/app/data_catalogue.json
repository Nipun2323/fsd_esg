  "principles": [
    {
      "code": "P1",
      "short": "Ethics & transparency",
      "statement": "Businesses should conduct and govern themselves with integrity in a manner that is ethical, transparent and accountable.",
      "pillar": "G"
    },
    {
      "code": "P2",
      "short": "Sustainable & safe goods",
      "statement": "Businesses should provide goods and services in a manner that is sustainable and safe.",
      "pillar": "E"
    },
    {
      "code": "P3",
      "short": "Employee wellbeing",
      "statement": "Businesses should respect and promote the wellbeing of all employees, including those in their value chains.",
      "pillar": "S"
    },
    {
      "code": "P4",
      "short": "Stakeholder responsiveness",
      "statement": "Businesses should respect the interests of and be responsive to all their stakeholders.",
      "pillar": "S"
    },
    {
      "code": "P5",
      "short": "Human rights",
      "statement": "Businesses should respect and promote human rights.",
      "pillar": "S"
    },
    {
      "code": "P6",
      "short": "Environment",
      "statement": "Businesses should respect and make efforts to protect and restore the environment.",
      "pillar": "E"
    },
    {
      "code": "P7",
      "short": "Policy advocacy",
      "statement": "Businesses, when engaging in influencing public and regulatory policy, should do so in a manner that is responsible and transparent.",
      "pillar": "G"
    },
    {
      "code": "P8",
      "short": "Inclusive growth",
      "statement": "Businesses should promote inclusive growth and equitable development.",
      "pillar": "S"
    },
    {
      "code": "P9",
      "short": "Consumer value",
      "statement": "Businesses should engage with and provide value to their consumers and customers in a responsible manner.",
      "pillar": "S"
    }
