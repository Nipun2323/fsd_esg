# ---------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored — never commit it.
# ---------------------------------------------------------------------

# Database. SQLite needs nothing installed and is the default.
#
# SQLite is for local development only. On a container platform the
# filesystem is ephemeral, so every deploy starts from an empty
# database — point this at a managed database before deploying.
DATABASE_URL=sqlite:///./esg.db
# MySQL, as per the project outline:
# DATABASE_URL=mysql+pymysql://esg:yourpassword@localhost:3306/esg
# PostgreSQL, the cheapest managed option on most clouds:
# DATABASE_URL=postgresql+psycopg://esg:yourpassword@localhost:5432/esg

# Sign JWTs with this. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Free Gemini key: https://aistudio.google.com/app/apikey
# Leave blank to run without AI — endpoints fall back to deterministic
# templates and label themselves as such.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Seeded on first run.
DEFAULT_ADMIN_USERNAME=Admin
DEFAULT_ADMIN_PASSWORD=12345

CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Import the bundled 722-company dataset when the container starts.
# Use it for a first deploy, then remove it: on a platform that runs
# several instances, each one would otherwise re-import on cold start.
SEED_ON_BOOT=false
